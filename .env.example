# ─────────────────────────────────────────────
# LinkedIn Autopilot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── GROQ ──────────────────────────────────────
# Get from: console.groq.com → API Keys → Create Key
GROQ_API_KEY=

# ── TELEGRAM ──────────────────────────────────
# Bot token: from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Your personal numeric Telegram user ID
# Get it: message your bot once, then visit
# https://api.telegram.org/bot{TOKEN}/getUpdates
# Look for "chat":{"id":XXXXXXXXX}
TELEGRAM_CHAT_ID=

# ── LINKEDIN ──────────────────────────────────
# Run: python scripts/get_linkedin_token.py
# Expires every 60 days — re-run script to refresh
LINKEDIN_ACCESS_TOKEN=
# Run: python scripts/get_linkedin_urn.py (after token)
LINKEDIN_PERSON_URN=

# ── REDDIT (optional — higher rate limits) ────
# Create app at: reddit.com/prefs/apps → "script" type
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linkedin-autopilot/1.0

# ── OPTIONAL ──────────────────────────────────
# Set to "true" to run pipeline immediately on startup (for testing)
RUN_NOW=false
# Override post time (default: 07:00 IST). Format: HH:MM
POST_TIME=07:00

# ── MISTRAL (optional — fallback LLM) ─────────
# Get from: console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ── NVIDIA NIM (optional — fallback LLM) ──────
# Get from: build.nvidia.com → API Keys
NVIDIA_NIM_API_KEY=

# ── GITHUB ACTIONS STATE BACKEND ──────────────
# Only needed when deploying via GitHub Actions (not needed for local/Render).
# STATE_BACKEND=gist tells helpers.py to use a GitHub Gist for persistence
# instead of state/today.json on disk.
#
# 1. Create a GitHub PAT with ONLY the "gist" scope:
#    https://github.com/settings/tokens/new
# 2. Run: python scripts/setup_gist_state.py
#    (with GIST_TOKEN set in your shell) — it prints your GIST_ID
# 3. Add GIST_TOKEN and GIST_ID as repo secrets in GitHub Actions.
#
# For local development, leave STATE_BACKEND unset (defaults to "file").
STATE_BACKEND=file
GIST_TOKEN=
GIST_ID=
